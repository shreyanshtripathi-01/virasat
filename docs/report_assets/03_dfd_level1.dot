digraph G {
graph [rankdir=LR, bgcolor=white, dpi=300, pad=.25, nodesep=.35, ranksep=.6, fontname="DejaVu Sans", fontsize=24, labelloc=t, label="Data flow diagram: Level 1"];
node [shape=box, style="rounded,filled", fillcolor="#FBF5E9", color="#1F2A56", fontcolor="#1F2A56", fontname="DejaVu Sans", fontsize=19, margin=".18,.12"];
edge [color="#615A53", fontcolor="#1F2A56", fontname="DejaVu Sans", fontsize=15, arrowsize=.7];
"people" [label="Marketplace\nusers",fillcolor="#ECEEF5"];
"p1" [label="1 Account\nmanagement",shape="ellipse",fillcolor="#FBEFEB"];
"p2" [label="2 Catalog\nmanagement",shape="ellipse",fillcolor="#FBEFEB"];
"p3" [label="3 AI\ncataloging",shape="ellipse",fillcolor="#FBEFEB"];
"p4" [label="4 Cart\nand orders",shape="ellipse",fillcolor="#FBEFEB"];
"p5" [label="5 Market\nlinkage",shape="ellipse",fillcolor="#FBEFEB"];
"p6" [label="6 Artisan\nverification",shape="ellipse",fillcolor="#FBEFEB"];
"p7" [label="7 Impact\nreporting",shape="ellipse",fillcolor="#FBEFEB"];
{rank=same; p1;p2;p3;p4;p5;p6;p7;}
"d1" [label="D1 Users\nand Profiles",shape="cylinder"];
"d2" [label="D2 Products, Crafts,\nCategories",shape="cylinder"];
"d3" [label="D3 Orders\nand Items",shape="cylinder"];
"d4" [label="D4 Requests\nand Proposals",shape="cylinder"];
"d5" [label="D5 Reviews\nand Wishlist",shape="cylinder"];
"ai" [label="AI Service\nOptional HTTPS API",fillcolor="#ECEEF5"];
"session" [label="Session cart\nand cookies",shape="note"];
"people" -> "p1" [label="Credentials",dir="both"];
"people" -> "p2" [label="Search / edits",dir="both"];
"people" -> "p3" [label="Craft facts",dir="both"];
"people" -> "p4" [label="Checkout",dir="both"];
"people" -> "p5" [label="Briefs / offers",dir="both"];
"people" -> "p6" [label="Decision",dir="both"];
"people" -> "p7" [label="Impact",dir="both"];
"p1" -> "d1" [label="Accounts",dir="both"];
"p2" -> "d2" [label="Catalog",dir="both"];
"p2" -> "d5" [label="Reviews, saves",dir="both"];
"p3" -> "d2" [label="Draft text",dir="both"];
"p4" -> "d2" [label="Stock",dir="both"];
"p4" -> "d3" [label="Orders",dir="both"];
"p5" -> "d4" [label="Briefs, offers",dir="both"];
"p6" -> "d1" [label="Verified status",dir="both"];
"p3" -> "ai" [label="Facts / JSON",dir="both"];
"p4" -> "session" [label="Quantities",dir="both"];
"d2" -> "p7" [label="Published",constraint="false"];
"d3" -> "p7" [label="Delivered",constraint="false"];
"d1" -> "p7" [label="Verified",constraint="false"];
"d5" -> "p7" [label="Ratings",constraint="false"];
}