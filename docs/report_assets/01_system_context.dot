digraph G {
graph [rankdir=LR, bgcolor=white, dpi=300, pad=.25, nodesep=.35, ranksep=.6, fontname="DejaVu Sans", fontsize=24, labelloc=t, label="Virasat: system context"];
node [shape=box, style="rounded,filled", fillcolor="#FBF5E9", color="#1F2A56", fontcolor="#1F2A56", fontname="DejaVu Sans", fontsize=19, margin=".18,.12"];
edge [color="#615A53", fontcolor="#1F2A56", fontname="DejaVu Sans", fontsize=15, arrowsize=.7];
"app" [label="Virasat\nDjango marketplace",fillcolor="#1F2A56",fontcolor="white"];
"visitor" [label="Visitor",fillcolor="#ECEEF5"];
"buyer" [label="Buyer",fillcolor="#ECEEF5"];
"artisan" [label="Artisan",fillcolor="#ECEEF5"];
"verifier" [label="Verifier",fillcolor="#ECEEF5"];
"admin" [label="Administrator",fillcolor="#ECEEF5"];
"visitor" -> "app" [label="Browse and install"];
"buyer" -> "app" [label="Shop and request"];
"artisan" -> "app" [label="Sell and fulfil"];
"verifier" -> "app" [label="Verify profiles"];
"admin" -> "app" [label="Maintain records"];
"ai" [label="Anthropic API\nOptional extension",fillcolor="#FBEFEB"];
"data" [label="SQLite database\nand uploaded media",shape="cylinder"];
"app" -> "ai" [label="Draft JSON\nover HTTPS",dir="both"];
"app" -> "data" [label="Read and write",dir="both"];
}