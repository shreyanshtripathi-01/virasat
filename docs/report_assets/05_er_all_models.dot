digraph G {
graph [rankdir=TB, bgcolor=white, dpi=300, pad=.25, nodesep=.35, ranksep=.6, fontname="DejaVu Sans", fontsize=24, labelloc=t, label="ER diagram: all concrete models"];
node [shape=box, style="rounded,filled", fillcolor="#FBF5E9", color="#1F2A56", fontcolor="#1F2A56", fontname="DejaVu Sans", fontsize=19, margin=".18,.12"];
edge [color="#615A53", fontcolor="#1F2A56", fontname="DejaVu Sans", fontsize=15, arrowsize=.7];
graph [splines=polyline, nodesep=.8, ranksep=1.2];
"auth.User" [shape=plain, style="", fontsize=18, pos="0,925!", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#1F2A56"><FONT COLOR="white"><B>User</B></FONT></TD></TR><TR><TD PORT="id" ALIGN="LEFT" BGCOLOR="#FBF5E9">PK id</TD></TR></TABLE>>];
"catalog.Category" [shape=plain, style="", fontsize=18, pos="245,925!", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#1F2A56"><FONT COLOR="white"><B>Category</B></FONT></TD></TR><TR><TD PORT="id" ALIGN="LEFT" BGCOLOR="#FBF5E9">PK id</TD></TR></TABLE>>];
"catalog.CraftTradition" [shape=plain, style="", fontsize=18, pos="490,925!", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#1F2A56"><FONT COLOR="white"><B>CraftTradition</B></FONT></TD></TR><TR><TD PORT="id" ALIGN="LEFT" BGCOLOR="#FBF5E9">PK id</TD></TR></TABLE>>];
