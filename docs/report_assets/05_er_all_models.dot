"auth.Group" [shape=plain, style="", fontsize=18, pos="490,370!", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#1F2A56"><FONT COLOR="white"><B>Group</B></FONT></TD></TR><TR><TD PORT="id" ALIGN="LEFT" BGCOLOR="#FBF5E9">PK id</TD></TR></TABLE>>];
"auth.Permission" [shape=plain, style="", fontsize=18, pos="0,185!", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#1F2A56"><FONT COLOR="white"><B>Permission</B></FONT></TD></TR><TR><TD PORT="id" ALIGN="LEFT" BGCOLOR="#FBF5E9">PK id</TD></TR><TR><TD PORT="content_type" ALIGN="LEFT" BGCOLOR="#FBF5E9">FK content_type_id [1]</TD></TR></TABLE>>];
"contenttypes.ContentType" [shape=plain, style="", fontsize=18, pos="245,185!", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#1F2A56"><FONT COLOR="white"><B>ContentType</B></FONT></TD></TR><TR><TD PORT="id" ALIGN="LEFT" BGCOLOR="#FBF5E9">PK id</TD></TR></TABLE>>];
"admin.LogEntry" [shape=plain, style="", fontsize=18, pos="490,185!", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#1F2A56"><FONT COLOR="white"><B>LogEntry</B></FONT></TD></TR><TR><TD PORT="id" ALIGN="LEFT" BGCOLOR="#FBF5E9">PK id</TD></TR><TR><TD PORT="user" ALIGN="LEFT" BGCOLOR="#FBF5E9">FK user_id [1]</TD></TR><TR><TD PORT="content_type" ALIGN="LEFT" BGCOLOR="#FBF5E9">FK content_type_id [0..1]</TD></TR></TABLE>>];
"sessions.Session" [shape=plain, style="", fontsize=18, pos="0,0!", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#1F2A56"><FONT COLOR="white"><B>Session</B></FONT></TD></TR><TR><TD PORT="session_key" ALIGN="LEFT" BGCOLOR="#FBF5E9">PK session_key</TD></TR></TABLE>>];
"auth.Group" -> "auth.User" [label="groups",dir="both",arrowhead="crow",arrowtail="crow",constraint="false"];
"auth.Permission" -> "auth.User" [label="user_permissions",dir="both",arrowhead="crow",arrowtail="crow",constraint="false"];
"auth.User":id -> "accounts.Profile":user [dir="both",arrowtail="tee",arrowhead="tee",constraint="false"];
"auth.User":id -> "accounts.Profile":verified_by [dir="both",arrowtail="tee",arrowhead="crow",constraint="false"];
