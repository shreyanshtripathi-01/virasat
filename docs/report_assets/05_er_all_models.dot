"catalog.Product" [shape=plain, style="", fontsize=18, pos="245,740!", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#1F2A56"><FONT COLOR="white"><B>Product</B></FONT></TD></TR><TR><TD PORT="id" ALIGN="LEFT" BGCOLOR="#FBF5E9">PK id</TD></TR><TR><TD PORT="artisan" ALIGN="LEFT" BGCOLOR="#FBF5E9">FK artisan_id [1]</TD></TR><TR><TD PORT="category" ALIGN="LEFT" BGCOLOR="#FBF5E9">FK category_id [1]</TD></TR><TR><TD PORT="craft" ALIGN="LEFT" BGCOLOR="#FBF5E9">FK craft_id [1]</TD></TR></TABLE>>];
"linkage.BuyerRequest" [shape=plain, style="", fontsize=18, pos="490,740!", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#1F2A56"><FONT COLOR="white"><B>BuyerRequest</B></FONT></TD></TR><TR><TD PORT="id" ALIGN="LEFT" BGCOLOR="#FBF5E9">PK id</TD></TR><TR><TD PORT="buyer" ALIGN="LEFT" BGCOLOR="#FBF5E9">FK buyer_id [1]</TD></TR><TR><TD PORT="category" ALIGN="LEFT" BGCOLOR="#FBF5E9">FK category_id [1]</TD></TR><TR><TD PORT="craft" ALIGN="LEFT" BGCOLOR="#FBF5E9">FK craft_id [0..1]</TD></TR></TABLE>>];
"orders.Order" [shape=plain, style="", fontsize=18, pos="0,555!", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#1F2A56"><FONT COLOR="white"><B>Order</B></FONT></TD></TR><TR><TD PORT="id" ALIGN="LEFT" BGCOLOR="#FBF5E9">PK id</TD></TR><TR><TD PORT="buyer" ALIGN="LEFT" BGCOLOR="#FBF5E9">FK buyer_id [1]</TD></TR></TABLE>>];
"catalog.Review" [shape=plain, style="", fontsize=18, pos="245,555!", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#1F2A56"><FONT COLOR="white"><B>Review</B></FONT></TD></TR><TR><TD PORT="id" ALIGN="LEFT" BGCOLOR="#FBF5E9">PK id</TD></TR><TR><TD PORT="product" ALIGN="LEFT" BGCOLOR="#FBF5E9">FK product_id [1]</TD></TR><TR><TD PORT="buyer" ALIGN="LEFT" BGCOLOR="#FBF5E9">FK buyer_id [1]</TD></TR></TABLE>>];
"linkage.Proposal" [shape=plain, style="", fontsize=18, pos="490,555!", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#1F2A56"><FONT COLOR="white"><B>Proposal</B></FONT></TD></TR><TR><TD PORT="id" ALIGN="LEFT" BGCOLOR="#FBF5E9">PK id</TD></TR><TR><TD PORT="request" ALIGN="LEFT" BGCOLOR="#FBF5E9">FK request_id [1]</TD></TR><TR><TD PORT="artisan" ALIGN="LEFT" BGCOLOR="#FBF5E9">FK artisan_id [1]</TD></TR></TABLE>>];
